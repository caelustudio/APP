<UserControl x:Class="DownloadCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             FontFamily="OPPO Sans 4.0, Microsoft YaHei">

    <UserControl.Resources>
        <!-- 版本/分类标签：恢复原版亮蓝配色，圆角矩形（非胶囊），不发光 -->
        <Style x:Key="DownloadTag" TargetType="Border" BasedOn="{StaticResource Tag}">
            <Setter Property="Background" Value="#FFE6F0FF"/>
            <Setter Property="BorderBrush" Value="#261E50A0"/>
            <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}"/>
        </Style>
        <Style x:Key="DownloadTagText" TargetType="TextBlock" BasedOn="{StaticResource TagTextStyle}">
            <Setter Property="Foreground" Value="#FF0A4A7A"/>
        </Style>

        <!-- 卡片正面：只负责描边和内边距，不带任何 Effect -->
        <Style x:Key="CardSurface" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineSoft}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="26"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- 阴影单独一层：文字必须待在 Effect 之外，否则会被合成层软化 -->
    <Grid>
        <Border CornerRadius="16" Background="{DynamicResource BgCard}"
                Effect="{DynamicResource CardShadow}" SnapsToDevicePixels="True"/>

        <Border Style="{StaticResource CardSurface}">
        <StackPanel>

            <!-- ============ 头部：图标 / 信息 / 元数据 ============ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="62" Height="62" CornerRadius="14" Margin="0,0,18,0"
                        ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{DynamicResource IconStart}" Offset="0"/>
                            <GradientStop Color="{DynamicResource IconEnd}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <TextBlock x:Name="txtFallback" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource BtnText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- CornerRadius 必须和外面一致，Border 才会把图片裁成圆角 -->
                        <Border x:Name="hostLogo" CornerRadius="14" Visibility="Collapsed"
                                RenderOptions.BitmapScalingMode="HighQuality">
                            <Border.Background>
                                <ImageBrush x:Name="brushLogo" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="txtName" FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>
                        <Border Style="{StaticResource DownloadTag}" Margin="12,0,0,0">
                            <TextBlock x:Name="txtVersion" Style="{StaticResource DownloadTagText}"/>
                        </Border>
                        <Border Style="{StaticResource DownloadTag}" Margin="8,0,0,0">
                            <TextBlock x:Name="txtCategory" Style="{StaticResource DownloadTagText}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="txtDescription" FontSize="13.5"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,9,0,0" TextWrapping="Wrap" LineHeight="22"/>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="26,0,0,0">
                    <TextBlock Text="文件大小" FontSize="12"
                               Foreground="{DynamicResource TextSubtle}"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="txtSize" Text="--" FontSize="16"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Right" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{DynamicResource LineDivider}" Margin="0,22,0,20"/>

            <!-- ============ 进度区 ============ -->
            <Grid Margin="0,0,0,7">
                <TextBlock Text="下载进度" FontSize="13"
                           Foreground="{DynamicResource TextSubtle}"/>
                <TextBlock x:Name="txtPercent" Text="0%" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           HorizontalAlignment="Right"/>
            </Grid>

            <ProgressBar x:Name="pbProgress" Style="{StaticResource CaelusProgressBar}"/>

            <Grid Margin="0,11,0,0">
                <TextBlock x:Name="txtStatus" FontSize="13"
                           Foreground="{DynamicResource TextMuted}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="txtDetail" FontSize="13"
                               Foreground="{DynamicResource TextSubtle}"/>
                    <TextBlock x:Name="txtSpeed" FontSize="13"
                               Foreground="{DynamicResource Accent}" Margin="14,0,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                <Button x:Name="btnDownload" Style="{StaticResource PrimaryButton}"
                        Content="下载" IsEnabled="False"/>
                <Button x:Name="btnCancel" Style="{StaticResource GhostButton}"
                        Content="取消" Margin="12,0,0,0" Visibility="Collapsed"/>
                <Button x:Name="btnOpenFile" Style="{StaticResource GhostButton}"
                        Content="打开文件" Margin="12,0,0,0" IsEnabled="False"/>
                <Button x:Name="btnOpenFolder" Style="{StaticResource GhostButton}"
                        Content="打开文件夹" Margin="12,0,0,0" IsEnabled="False"/>
            </StackPanel>

            <TextBlock x:Name="txtSource" Margin="0,18,0,0" FontSize="12"
                       Foreground="{DynamicResource TextFaint}" TextWrapping="Wrap"
                       Visibility="Collapsed"/>

        </StackPanel>
        </Border>
    </Grid>
</UserControl>
