<Window x:Class="UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="发现新版本"
        Width="500" SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        FontFamily="OPPO Sans 4.0, Microsoft YaHei"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- 圆角窗口三件套：透明底 + 外层 Border 画圆角 + SizeChanged 里套圆角裁剪（否则子元素会从圆角处顶出来） -->
    <Border x:Name="rootBorder" CornerRadius="10"
            BorderBrush="{DynamicResource FrameBorder}" BorderThickness="1"
            Background="{DynamicResource BgPrimary}"
            ClipToBounds="True"
            SizeChanged="RootBorder_SizeChanged">
        <StackPanel>

            <!-- 标题栏（CaptionHeight 让系统接管拖动） -->
            <Grid Height="36" Background="{DynamicResource BgPrimary}">
                <TextBlock x:Name="txtTitleBar" Text="发现新版本" Margin="16,0,0,0" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"/>
                <Button x:Name="btnClose" Style="{StaticResource TitleBarCloseButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="&#xE8BB;" HorizontalAlignment="Right"/>
            </Grid>

            <StackPanel Margin="24,6,24,24">

                <TextBlock x:Name="txtHeading" Text="Caelus Studio 有新版本可用" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"/>

                <!-- 版本 -->
                <Border Style="{StaticResource SoftCardStyle}" Margin="0,16,0,0" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="当前版本" FontSize="13"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="txtCurrent" Text="-" FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="16,0,0,0" VerticalAlignment="Center"/>
                        <Border Grid.Column="2" Style="{StaticResource Tag}">
                            <TextBlock x:Name="txtNew" Text="-" FontSize="12.5"
                                       Style="{StaticResource TagTextStyle}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- 更新说明 -->
                <TextBlock Text="更新说明" FontSize="13" Margin="0,18,0,8"
                           Foreground="{DynamicResource TextSubtle}"/>
                <Border Style="{StaticResource SoftCardStyle}" Padding="18,14">
                    <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="txtNotes" FontSize="13" TextWrapping="Wrap"
                                   LineHeight="22" Foreground="{DynamicResource TextSecondary}"/>
                    </ScrollViewer>
                </Border>

                <!-- ============ 更新进度（点击「立即更新」后出现） ============ -->
                <Border x:Name="panelProgress" Style="{StaticResource SoftCardStyle}"
                        Margin="0,18,0,0" Padding="18,14" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,9">
                            <TextBlock x:Name="txtProgressTitle" Text="正在下载更新" FontSize="13"
                                       Foreground="{DynamicResource TextSubtle}"/>
                            <TextBlock x:Name="txtPercent" Text="0%" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <ProgressBar x:Name="pbDownload" Style="{StaticResource CaelusProgressBar}"/>

                        <Grid Margin="0,11,0,0">
                            <TextBlock x:Name="txtStatus" Text="准备中…" FontSize="12.5"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtSpeed" FontSize="12.5"
                                       Foreground="{DynamicResource Accent}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 失败原因 -->
                <TextBlock x:Name="txtError" FontSize="12.5" Margin="0,14,0,0" TextWrapping="Wrap"
                           LineHeight="19" Foreground="{DynamicResource Danger}"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="txtForce" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFaint}" Visibility="Collapsed">
                    这是必须安装的更新：更新后才能继续使用，也可以直接退出应用。
                </TextBlock>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button x:Name="btnManual" Style="{StaticResource GhostButton}"
                            Content="手动下载" Padding="18,7" Visibility="Collapsed"/>
                    <Button x:Name="btnRetry" Style="{StaticResource GhostButton}"
                            Content="重试" Padding="18,7" Margin="12,0,0,0" Visibility="Collapsed"/>
                    <Button x:Name="btnExit" Style="{StaticResource GhostButton}"
                            Content="退出应用" Padding="18,7" Visibility="Collapsed"/>
                    <Button x:Name="btnLater" Style="{StaticResource GhostButton}"
                            Content="稍后再说" Padding="18,7"/>
                    <Button x:Name="btnCancel" Style="{StaticResource GhostButton}"
                            Content="取消" Padding="18,7" Visibility="Collapsed"/>
                    <Button x:Name="btnDone" Style="{StaticResource GhostButton}"
                            Content="关闭" Padding="18,7" Visibility="Collapsed"/>
                    <Button x:Name="btnUpdate" Style="{StaticResource PrimaryButton}"
                            Content="立即更新" Padding="22,7" Margin="12,0,0,0"/>
                </StackPanel>

            </StackPanel>
        </StackPanel>
    </Border>
</Window>
