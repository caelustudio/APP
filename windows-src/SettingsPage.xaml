<Page x:Class="SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="设置"
      Background="{DynamicResource BgPrimary}"
      FontFamily="OPPO Sans 4.0, Microsoft YaHei"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      RenderOptions.BitmapScalingMode="HighQuality">

    <Page.RenderTransform>
        <TranslateTransform/>
    </Page.RenderTransform>

    <!-- 入场：淡入 + 上滑 -->
    <Page.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard Completed="EnterAnim_Completed">
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35"/>
                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="18" To="0" Duration="0:0:0.42">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <Grid ClipToBounds="True">

        <!-- 铺满窗口宽度：靠 Margin 留一点白。
             HorizontalContentAlignment 必须显式设 Stretch，ScrollViewer 默认是 Left -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      HorizontalContentAlignment="Stretch">
            <StackPanel Margin="32,36,32,44">

                <TextBlock Text="设置" Style="{StaticResource TypeDisplay}"
                           Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock FontSize="14" Foreground="{DynamicResource TextMuted}"
                           Margin="0,8,0,26" TextWrapping="Wrap" LineHeight="24">
                    账户、下载位置等选项都集中在这里。
                </TextBlock>

                <!-- ============ 账户 ============ -->
                <TextBlock Text="账户" Style="{StaticResource TypeSection}"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>
                <Border Style="{StaticResource SoftCardStyle}">
                    <StackPanel Margin="24,20,24,24">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Caelus Star ID" FontSize="14.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock x:Name="txtAccountDetail" FontSize="13"
                                           Foreground="{DynamicResource TextMuted}"
                                           Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource Tag}"
                                    VerticalAlignment="Top" Margin="12,0,0,0">
                                <TextBlock x:Name="txtAccountState" Style="{StaticResource TagTextStyle}"/>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                            <Button x:Name="btnSignIn" Style="{StaticResource PrimaryButton}"
                                    Content="登录 Star ID" Padding="18,7"/>
                            <Button x:Name="btnSignOut" Style="{StaticResource GhostButton}"
                                    Content="退出登录" Padding="18,7" Margin="10,0,0,0"/>
                            <Button x:Name="btnCopyId" Style="{StaticResource LinkButton}"
                                    Content="复制 Star ID" Margin="16,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- 账号详情：登录后把服务端返回的全部字段都列出来 -->
                        <StackPanel x:Name="pnlAccountInfo" Margin="0,20,0,0" Visibility="Collapsed">
                            <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0"
                                    Margin="0,0,0,16"/>

                            <TextBlock Text="账号详情" FontSize="13.5" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFaint}"
                                       Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20">
                                以下内容全部来自 Caelus Star ID 服务端返回值。
                            </TextBlock>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Star ID" FontSize="13" Foreground="{DynamicResource TextSubtle}"/>
                                <TextBlock x:Name="txtInfoStarId" Grid.Column="1" FontSize="13"
                                           Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="昵称" FontSize="13" Foreground="{DynamicResource TextSubtle}"/>
                                <TextBlock x:Name="txtInfoNickname" Grid.Column="1" FontSize="13"
                                           Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="邮箱" FontSize="13" Foreground="{DynamicResource TextSubtle}"/>
                                <TextBlock x:Name="txtInfoEmail" Grid.Column="1" FontSize="13"
                                           Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="注册时间" FontSize="13" Foreground="{DynamicResource TextSubtle}"/>
                                <TextBlock x:Name="txtInfoCreated" Grid.Column="1" FontSize="13"
                                           Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="授权范围" FontSize="13" Foreground="{DynamicResource TextSubtle}"/>
                                <TextBlock x:Name="txtInfoScope" Grid.Column="1" FontSize="13"
                                           Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap"/>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="96"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="令牌到期" FontSize="13" Foreground="{DynamicResource TextSubtle}"/>
                                <TextBlock x:Name="txtInfoExpiry" Grid.Column="1" FontSize="13"
                                           Foreground="{DynamicResource TextSubtle}" TextWrapping="Wrap"/>
                            </Grid>
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,1,0,0"
                                Margin="0,22,0,18"/>

                        <TextBlock Text="接入配置" FontSize="13.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFaint}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20">
                            接入配置由应用内置，界面不展示明文，也不支持在此查看或修改。
                        </TextBlock>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="客户端 ID" FontSize="13"
                                       Foreground="{DynamicResource TextSubtle}"/>
                            <TextBlock x:Name="txtClientId" Grid.Column="1" FontSize="13"
                                       Foreground="{DynamicResource TextSubtle}"
                                       Text="当前暂无权限查看"/>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="回调地址" FontSize="13"
                                       Foreground="{DynamicResource TextSubtle}"/>
                            <TextBlock x:Name="txtRedirect" Grid.Column="1" FontSize="13"
                                       Foreground="{DynamicResource TextSubtle}"
                                       Text="当前暂无权限查看"/>
                        </Grid>

                        <!-- 「配置客户端 ID…」按钮已删：client_id 由应用内置，用户无需配置（1.2.0） -->

                    </StackPanel>
                </Border>

                <!-- ============ 下载 ============ -->
                <TextBlock Text="下载" Style="{StaticResource TypeSection}"
                           Foreground="{DynamicResource TextPrimary}" Margin="0,32,0,12"/>
                <Border Style="{StaticResource SoftCardStyle}">
                    <StackPanel Margin="24,20,24,24">

                        <TextBlock Text="保存位置" FontSize="14.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource TextFaint}"
                                   Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="20">
                            应用内下载的作品文件都会存到这个文件夹。
                        </TextBlock>

                        <Border Style="{StaticResource SoftCardStyle}" Padding="14,10" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="txtFolder" FontSize="13"
                                           Foreground="{DynamicResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>

                                <Button x:Name="btnPickFolder" Grid.Column="1"
                                        Style="{StaticResource GhostButton}"
                                        Content="更改" Padding="14,6" FontSize="13" Margin="16,0,0,0"/>
                                <Button x:Name="btnOpenFolder" Grid.Column="2"
                                        Style="{StaticResource LinkButton}"
                                        Content="打开" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                <Button x:Name="btnResetFolder" Grid.Column="3"
                                        Style="{StaticResource LinkButton}"
                                        Content="恢复默认" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
